# Copy ke .env.local dan isi sesuai environment
# cp .env.example .env.local

DATABASE_URL=""
# AUTH_SECRET wajib — generate dengan: openssl rand -base64 32
# atau: npx auth secret  (Auth.js CLI)
AUTH_SECRET=""
# (opsional) URL site — dibutuhkan Auth.js untuk callback di production
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Seed ADMIN (hanya dipakai `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@properti360.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="Admin Properti360"

RESEND_API_KEY=""
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
# S3-compatible (Biznet Gio Neo Object Storage) — isi jika STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT="https://is3.cloudhost.id"
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
STORAGE_S3_BUCKET="properti360"
STORAGE_S3_REGION="ap-southeast-1"
STORAGE_S3_FORCE_PATH_STYLE="true"
# opsional
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
