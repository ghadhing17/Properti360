# Copy ke .env.local dan isi sesuai environment
# cp .env.example .env.local

# ── Database (WAJIB) ──
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Lokal via SSH tunnel:  postgresql://postgres:***@localhost:5434/postgres
# Coolify internal:      postgresql://postgres:***@<postgres-container-host>:5432/postgres
DATABASE_URL=""

# ── Auth.js (WAJIB) ──
# Generate dengan: openssl rand -base64 32  atau: npx auth secret
AUTH_SECRET=""
# URL site — WAJIB di production (untuk callback Auth.js & canonical SEO)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Seed ADMIN (dipakai `npm run db:seed` atau SEED_ON_BOOT=true) ──
SEED_ADMIN_EMAIL="admin@properti360.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NAME="Admin Properti360"
# Set true agar container otomatis seed admin saat boot pertama (opsional)
# SEED_ON_BOOT="true"

# ── Email (opsional — kosongkan jika belum pakai Resend) ──
RESEND_API_KEY=""

# ── Storage (WAJIB) ──
STORAGE_DRIVER="local"
# Path di dalam container — HARUS sama dengan mount Persistent Volume di Coolify
STORAGE_LOCAL_PATH="./storage/uploads"
# S3-compatible (Biznet Gio Neo Object Storage) — isi jika STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT="https://is3.cloudhost.id"
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
STORAGE_S3_BUCKET="properti360"
STORAGE_S3_REGION="ap-southeast-1"
STORAGE_S3_FORCE_PATH_STYLE="true"
